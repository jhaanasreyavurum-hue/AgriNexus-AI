# AgriNexus AI — secrets template.
#
# Local:  copy to .streamlit/secrets.toml (git-ignored).
# Cloud:  paste the keys you need into Streamlit Community Cloud → App → Settings → Secrets.
#
# EVERY KEY IS OPTIONAL. The application runs completely without secrets:
#   • weather  → Open-Meteo (no key) with an offline fallback
#   • Copilot  → rule-based / knowledge-base reasoning (no key)
#   • maps     → pydeck on the Carto basemap (no Mapbox token)
#   • storage  → in-memory session registry (no database)
# Keys are read via st.secrets (or the environment) and are never displayed in the UI.

# ── Weather (optional) ───────────────────────────────────────────────────────
# "open_meteo" (default, keyless) or "openweathermap" (requires the key below).
# If "openweathermap" is set without a key the app silently falls back to Open-Meteo.
# WEATHER_PROVIDER = "open_meteo"
# OPENWEATHER_API_KEY = ""

# ── LLM narrator for the Copilot (optional) ──────────────────────────────────
# Enables a "rephrase only" toggle on the Copilot pages. The narrator never
# changes eligibility, products, benefits or numbers; it is disabled when unset.
# LLM_PROVIDER = "openai"        # openai | anthropic | gemini
# LLM_API_KEY  = ""
# LLM_MODEL    = ""              # optional model override
